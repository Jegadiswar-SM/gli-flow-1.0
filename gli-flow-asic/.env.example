# =============================================================================
# GLI-FLOW Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For local SQLite development (default): leave DATABASE_URL unset
# For PostgreSQL: set DATABASE_URL to your connection string
# =============================================================================

# --- Database ---
# PostgreSQL connection string (optional).
# When set, GLI-FLOW uses PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite database path override (optional).
# Only used when DATABASE_URL is not set.
# GLI_FLOW_DB=/home/user/.gli_flow/gli_flow.db
# GLI_FLOW_DB_PATH=/home/user/.gli_flow/gli_flow.db

# --- Backend ---
# Port for the FastAPI backend server
# GLI_FLOW_BACKEND_PORT=8000

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / BharatCode ---
# BHARATCODE_API_KEY=your-api-key

# --- Telemetry ---
# Optional Failure Atlas/telemetry service configuration
# GLI_SERVER_URL=https://your-api.example.com
# GLI_API_KEY=your-api-key
